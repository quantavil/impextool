{
  "name": "impextool",
  "version": "3.1.0",
  "description": "Fills the ProductFormat.xlsx template for Indian export shipping-bill filing: duty lookup, scheme codes, IGST, and an editable review sheet.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantavil/impextool.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/clean.ts && bun build ./index.html --outdir dist --minify --splitting",
    "serve": "bun run build && bun server/serve.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "knip": "bunx --bun knip",
    "check": "bun run lint && bun run typecheck && bun run knip && bun run test"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "xlsx-js-style": "1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "typescript": "^7.0.2"
  }
}
